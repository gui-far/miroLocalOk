# =============================================================
# MiroFish-Offline Configuration
# =============================================================
# LLM: any OpenAI-compatible API (cloud)
# Memory: local Neo4j + local in-process embeddings (no Ollama)
# Copy this file to .env and fill in your API key.
# =============================================================

# ===== LLM Configuration (OpenAI-compatible format) =====
# The code sends `temperature` and `max_tokens` on every call, so use a model
# that accepts both. Tested: OpenAI gpt-4.1-mini (GPT-5 models reject them).
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4.1-mini

# Alternative: Claude via Anthropic's OpenAI-compatible endpoint (untested)
# LLM_API_KEY=your_anthropic_api_key_here
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL_NAME=claude-haiku-4-5

# ===== Neo4j Configuration =====
# docker compose overrides this with bolt://neo4j:7687 inside the container
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Embedding Configuration =====
# Runs inside the backend (FastEmbed / ONNX, CPU). Must produce 768-dim vectors.
# Multilingual model: understands Portuguese (nomic-embed-text is English-centric)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
